    async function initMortgageRatesWidget() \{\
        const widget = $("#ue-mortgage-widget");\
        if (!widget) return;\
\
        let cached = null;\
        try \{ cached = JSON.parse(localStorage.getItem(MORTGAGE_RATES_CACHE_KEY) || "null"); \} catch (e) \{\}\
        if (cached && Array.isArray(cached.banks)) mortgageRatesRender(cached, true);\
\
        try \{\
            const response = await fetch(MORTGAGE_RATES_API_URL, \{\
                method: "GET",\
                headers: \{ "Accept": "application/json" \},\
                cache: "no-store"\
            \});\
            if (!response.ok) throw new Error("HTTP " + response.status);\
            const data = await response.json();\
            if (!data || data.ok !== true || !Array.isArray(data.banks) || !data.banks.length) \{\
                throw new Error("\uc0\u1053 \u1077 \u1082 \u1086 \u1088 \u1088 \u1077 \u1082 \u1090 \u1085 \u1099 \u1081  \u1086 \u1090 \u1074 \u1077 \u1090  API");\
            \}\
            mortgageRatesRender(data, false);\
            try \{\
                localStorage.setItem(MORTGAGE_RATES_CACHE_KEY, JSON.stringify(\{\
                    banks: data.banks,\
                    liveCount: data.liveCount,\
                    savedAt: Date.now()\
                \}));\
            \} catch (e) \{\}\
        \} catch (error) \{\
            console.error("Urban Estate Mortgage Rates:", error);\
            const state = $("#ue-mortgage-state");\
            if (state) \{\
                state.classList.add("is-error");\
                if (!cached || !Array.isArray(cached.banks)) \{\
                    const list = $("#ue-mortgage-list");\
                    if (list) list.textContent = "";\
                    state.textContent = "\uc0\u1053 \u1077  \u1091 \u1076 \u1072 \u1083 \u1086 \u1089 \u1100  \u1079 \u1072 \u1075 \u1088 \u1091 \u1079 \u1080 \u1090 \u1100  \u1089 \u1090 \u1072 \u1074 \u1082 \u1080 . \u1054 \u1073 \u1085 \u1086 \u1074 \u1080 \u1090 \u1077  \u1089 \u1090 \u1088 \u1072 \u1085 \u1080 \u1094 \u1091  \u1087 \u1086 \u1079 \u1078 \u1077 .";\
                \}\
            \}\
        \}\
    \}\
