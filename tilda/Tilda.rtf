\
\
\
\
    function newsFormatTime(item) \{\
\
\
\
        if (\
\
            typeof item.age ===\
\
            "number"\
\
        ) \{\
\
\
\
            if (item.age < 1) \{\
\
                return "\uc0\u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1095 \u1090 \u1086 ";\
\
            \}\
\
\
\
            if (item.age < 60) \{\
\
                return (\
\
                    item.age +\
\
                    " \uc0\u1084 \u1080 \u1085  \u1085 \u1072 \u1079 \u1072 \u1076 "\
\
                );\
\
            \}\
\
\
\
            const hours =\
\
                Math.floor(\
\
                    item.age / 60\
\
                );\
\
\
\
            if (hours < 24) \{\
\
                return (\
\
                    hours +\
\
                    " \uc0\u1095  \u1085 \u1072 \u1079 \u1072 \u1076 "\
\
                );\
\
            \}\
\
\
\
            const days =\
\
                Math.floor(\
\
                    hours / 24\
\
                );\
\
\
\
            return days === 1\
\
                ? "\uc0\u1074 \u1095 \u1077 \u1088 \u1072 "\
\
                : days + " \uc0\u1076 \u1085  \u1085 \u1072 \u1079 \u1072 \u1076 ";\
\
\
\
        \}\
\
\
\
\
\
        const value =\
\
            item.publishedAt ||\
\
            item.published ||\
\
            item.date ||\
\
            "";\
\
\
\
\
\
        if (!value) \{\
\
            return "";\
\
        \}\
\
\
\
\
\
        const date =\
\
            new Date(value);\
\
\
\
\
\
        if (\
\
            Number.isNaN(\
\
                date.getTime()\
\
            )\
\
        ) \{\
\
            return "";\
\
        \}\
\
\
\
\
\
        const diff =\
\
            Date.now() -\
\
            date.getTime();\
\
\
\
        const minute =\
\
            60 * 1000;\
\
\
\
        const hour =\
\
            60 * minute;\
\
\
\
        const day =\
\
            24 * hour;\
\
\
\
\
\
        if (diff < minute) \{\
\
            return "\uc0\u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1095 \u1090 \u1086 ";\
\
        \}\
\
\
\
        if (diff < hour) \{\
\
            return (\
\
                Math.floor(\
\
                    diff / minute\
\
                ) +\
\
                " \uc0\u1084 \u1080 \u1085  \u1085 \u1072 \u1079 \u1072 \u1076 "\
\
            );\
\
        \}\
\
\
\
        if (diff < day) \{\
\
            return (\
\
                Math.floor(\
\
                    diff / hour\
\
                ) +\
\
                " \uc0\u1095  \u1085 \u1072 \u1079 \u1072 \u1076 "\
\
            );\
\
        \}\
\
\
\
        if (diff < 7 * day) \{\
\
            return (\
\
                Math.floor(\
\
                    diff / day\
\
                ) +\
\
                " \uc0\u1076 \u1085  \u1085 \u1072 \u1079 \u1072 \u1076 "\
\
            );\
\
        \}\
\
\
\
\
\
        return date.toLocaleDateString(\
\
            "ru-RU",\
\
            \{\
\
                day: "2-digit",\
\
                month: "2-digit"\
\
            \}\
\
        );\
\
\
\
    \}\
\
\
\
\
\
    function newsGetCategory(item) \{\
\
\
\
