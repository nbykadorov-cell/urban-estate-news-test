    function formatDate(timestamp) \{\
\
\
\
        if (!timestamp) \{\
\
            return "";\
\
        \}\
\
\
\
        const date =\
\
            new Date(timestamp);\
\
\
\
        const diff =\
\
            Date.now() -\
\
            date.getTime();\
\
\
\
        const minute =\
\
            60 * 1000;\
\
\
\
        const hour =\
\
            60 * minute;\
\
\
\
        const day =\
\
            24 * hour;\
\
\
\
\
\
        if (diff < minute) \{\
\
            return "\uc0\u1090 \u1086 \u1083 \u1100 \u1082 \u1086  \u1095 \u1090 \u1086 ";\
\
        \}\
\
\
\
        if (diff < hour) \{\
\
            return (\
\
                Math.floor(\
\
                    diff / minute\
\
                ) +\
\
                " \uc0\u1084 \u1080 \u1085  \u1085 \u1072 \u1079 \u1072 \u1076 "\
\
            );\
\
        \}\
\
\
\
        if (diff < day) \{\
\
            return (\
\
                Math.floor(\
\
                    diff / hour\
\
                ) +\
\
                " \uc0\u1095  \u1085 \u1072 \u1079 \u1072 \u1076 "\
\
            );\
\
        \}\
\
\
\
        if (diff < 7 * day) \{\
\
            return (\
\
                Math.floor(\
\
                    diff / day\
\
                ) +\
\
                " \uc0\u1076 \u1085  \u1085 \u1072 \u1079 \u1072 \u1076 "\
\
            );\
\
        \}\
\
\
\
        return date.toLocaleDateString(\
\
            "ru-RU",\
\
            \{\
\
                day: "numeric",\
\
                month: "short"\
\
            \}\
\
        );\
\
\
\
    \}\
\
\
\
\
