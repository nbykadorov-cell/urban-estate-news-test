\
\
\
    function newsEscape(value) \{\
\
\
\
        return String(\
\
            value == null ? "" : value\
\
        )\
\
            .replace(/&/g,"&amp;")\
\
            .replace(/</g,"&lt;")\
\
            .replace(/>/g,"&gt;")\
\
            .replace(/"/g,"&quot;")\
\
            .replace(/'/g,"&#039;");\
\
\
\
    \}\
\
\
\
\
\
    function newsStripHtml(value) \{\
\
\
\
        return String(\
\
            value || ""\
\
        )\
\
            .replace(\
\
                /<[^>]*>/g,\
\
                " "\
\
            )\
\
            .replace(\
\
                /\\s+/g,\
\
                " "\
\
            )\
