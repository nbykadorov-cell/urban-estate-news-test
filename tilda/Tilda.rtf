\
            loaded\
\
                .filter(\
\
                    item =>\
\
                        !item.lastOpen ||\
\
                        now -\
\
                        item.lastOpen <\
\
                        HISTORY_TTL\
\
                )\
\
                .filter(\
\
                    item =>\
\
                        item.id &&\
\
                        item.url\
\
                );\
\
\
\
\
\
        loaded.sort(\
\
            (a,b) =>\
\
                (b.lastOpen || 0) -\
\
                (a.lastOpen || 0)\
\
        );\
\
\
\
\
\
        return loaded.slice(\
\
            0,\
\
            MAX_HISTORY\
\
        );\
