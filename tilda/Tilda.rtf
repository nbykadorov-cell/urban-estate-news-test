\
    function readJSON(key, fallback) \{\
\
\
\
        try \{\
\
\
\
            const value =\
\
                JSON.parse(\
\
                    localStorage.getItem(key)\
\
                );\
\
\
\
            return value ?? fallback;\
\
\
\
        \} catch (error) \{\
\
\
\
            return fallback;\
\
\
\
        \}\
\
\
\
    \}\
\
\
\
\
\
    function loadPinned() \{\
\
\
\
        let pinned =\
\
            readJSON(\
\
                PINNED_KEY,\
\
                []\
\
            );\
\
\
\
        if (!Array.isArray(pinned)) \{\
\
            pinned = [];\
\
        \}\
\
\
\
        pinned =\
\
            [\
\
                ...new Set(\
\
                    pinned\
\
                        .filter(Boolean)\
\
                        .map(String)\
\
                )\
\
            ];\
\
\
\
\
\
        if (\
\
            localStorage.getItem(\
\
                PINS_MIGRATED_KEY\
\
            ) !== "1"\
\
        ) \{\
\
\
\
            const migrated = [];\
\
\
\
            const oldHistory =\
\
                readJSON(\
\
                    OLD_STORAGE_KEY,\
\
                    []\
\
                );\
\
\
\
            if (Array.isArray(oldHistory)) \{\
\
\
\
                oldHistory.forEach(item => \{\
\
\
\
                    if (!item?.pinned) \{\
\
                        return;\
\
                    \}\
\
\
\
                    const service =\
\
                        services.find(\
\
                            service =>\
\
                                service.url ===\
\
                                item.link\
\
                        );\
\
\
\
                    if (service) \{\
\
                        migrated.push(\
\
                            service.id\
\
                        );\
\
                    \}\
\
\
\
                \});\
\
\
\
            \}\
\
\
\
            pinned =\
\
                [\
\
                    ...new Set(\
\
                        [\
\
                            ...pinned,\
\
                            ...migrated\
\
                        ]\
\
                    )\
\
                ];\
\
\
\
            localStorage.setItem(\
\
                PINNED_KEY,\
\
                JSON.stringify(pinned)\
\
            );\
\
\
\
            localStorage.setItem(\
\
                PINS_MIGRATED_KEY,\
\
                "1"\
\
            );\
\
\
\
        \}\
\
\
\
        return pinned;\
\
\
\
    \}\
\
\
\
\
