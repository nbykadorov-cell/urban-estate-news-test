\
\
        if (!Array.isArray(loaded)) \{\
\
            loaded = [];\
\
        \}\
\
\
\
\
\
        if (!loaded.length) \{\
\
\
\
            const old =\
\
                readJSON(\
\
                    OLD_STORAGE_KEY,\
\
                    []\
\
                );\
\
\
\
            if (\
\
                Array.isArray(old) &&\
\
                old.length\
\
            ) \{\
\
\
\
                loaded =\
\
                    old\
\
                        .map(item => \{\
\
\
\
                            const service =\
\
                                services.find(\
\
                                    service =>\
\
                                        service.url ===\
\
                                        item.link\
\
                                );\
\
\
\
                            return \{\
\
\
\
                                id:\
\
                                    service?.id ||\
\
                                    "old-" +\
\
                                    Date.now() +\
\
                                    Math.random(),\
\
\
\
                                url:\
\
                                    item.link || "",\
\
\
\
                                title:\
\
                                    service?.title ||\
\
                                    item.title ||\
\
                                    "\uc0\u1057 \u1077 \u1088 \u1074 \u1080 \u1089 ",\
\
\
\
                                icon:\
\
                                    service?.icon ||\
\
                                    item.image ||\
\
                                    "",\
\
\
\
                                category:\
\
                                    service?.category ||\
\
                                    "",\
\
\
\
                                clicks:\
\
                                    Number(\
\
                                        item.clicks\
\
                                    ) || 1,\
\
\
\
                                lastOpen:\
\
                                    Number(\
\
                                        item.lastOpen\
\
                                    ) ||\
\
                                    Date.now()\
\
\
\
                            \};\
\
\
\
                        \})\
\
                        .filter(\
\
                            item =>\
\
                                item.url\
\
                        );\
\
\
\
                saveHistory(\
\
                    loaded\
\
                );\
\
\
\
            \}\
\
\
\
        \}\
\
\
\
\
\
        const now =\
\
            Date.now();\
\
\
\
\
\
