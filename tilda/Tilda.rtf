\
    const KEY_RATE_API_URL = "https://urban-estate-news-test.vercel.app/api/key-rate";\
    const KEY_RATE_CACHE_KEY = "ueKeyRateCacheV1";\
\
    function keyRateRender(data, stale) \{\
        const valueEl = $("#ue-key-rate-value");\
        const dateEl = $("#ue-key-rate-date");\
        const stateEl = $("#ue-key-rate-state");\
        if (!valueEl || !dateEl || !stateEl || !data || !data.rate) return;\
\
        valueEl.classList.remove("ue-key-rate-skeleton");\
        valueEl.removeAttribute("aria-label");\
        valueEl.textContent = String(data.rate).replace(".", ",");\
        dateEl.textContent = data.date ? "\uc0\u1053 \u1072  " + data.date : "\u1044 \u1072 \u1090 \u1072  \u1085 \u1077  \u1091 \u1082 \u1072 \u1079 \u1072 \u1085 \u1072 ";\
        stateEl.classList.toggle("is-error", Boolean(stale));\
        stateEl.textContent = stale\
            ? "\uc0\u1053 \u1077  \u1091 \u1076 \u1072 \u1083 \u1086 \u1089 \u1100  \u1086 \u1073 \u1085 \u1086 \u1074 \u1080 \u1090 \u1100  \'b7 \u1087 \u1086 \u1082 \u1072 \u1079 \u1072 \u1085 \u1099  \u1087 \u1086 \u1089 \u1083 \u1077 \u1076 \u1085 \u1080 \u1077  \u1089 \u1086 \u1093 \u1088 \u1072 \u1085 \u1105 \u1085 \u1085 \u1099 \u1077  \u1076 \u1072 \u1085 \u1085 \u1099 \u1077 "\
            : "\uc0\u1040 \u1082 \u1090 \u1091 \u1072 \u1083 \u1100 \u1085 \u1099 \u1077  \u1076 \u1072 \u1085 \u1085 \u1099 \u1077  \'b7 \u1086 \u1073 \u1085 \u1086 \u1074 \u1083 \u1103 \u1102 \u1090 \u1089 \u1103  \u1072 \u1074 \u1090 \u1086 \u1084 \u1072 \u1090 \u1080 \u1095 \u1077 \u1089 \u1082 \u1080 ";\
    \}\
\
    async function initKeyRateWidget() \{\
        const card = $("#ue-key-rate-card");\
        if (!card) return;\
\
        let cached = null;\
        try \{\
            cached = JSON.parse(localStorage.getItem(KEY_RATE_CACHE_KEY) || "null");\
        \} catch (e) \{\}\
\
        if (cached && cached.rate) keyRateRender(cached, true);\
\
        try \{\
            const response = await fetch(KEY_RATE_API_URL, \{\
                method: "GET",\
                headers: \{ "Accept": "application/json" \},\
                cache: "no-store"\
            \});\
            if (!response.ok) throw new Error("HTTP " + response.status);\
\
            const data = await response.json();\
            if (!data || data.ok !== true || !data.rate || !data.date) \{\
                throw new Error("\uc0\u1053 \u1077 \u1082 \u1086 \u1088 \u1088 \u1077 \u1082 \u1090 \u1085 \u1099 \u1081  \u1086 \u1090 \u1074 \u1077 \u1090  API");\
            \}\
\
            keyRateRender(data, false);\
            try \{\
                localStorage.setItem(KEY_RATE_CACHE_KEY, JSON.stringify(\{\
                    rate: data.rate,\
                    date: data.date,\
                    fetchedAt: Date.now()\
                \}));\
            \} catch (e) \{\}\
        \} catch (error) \{\
            console.error("Urban Estate Key Rate:", error);\
            if (!cached || !cached.rate) \{\
                const valueEl = $("#ue-key-rate-value");\
                const dateEl = $("#ue-key-rate-date");\
                const stateEl = $("#ue-key-rate-state");\
                if (valueEl) \{\
                    valueEl.classList.remove("ue-key-rate-skeleton");\
                    valueEl.textContent = "\'97";\
                \}\
                if (dateEl) dateEl.textContent = "\uc0\u1044 \u1072 \u1085 \u1085 \u1099 \u1077  \u1074 \u1088 \u1077 \u1084 \u1077 \u1085 \u1085 \u1086  \u1085 \u1077 \u1076 \u1086 \u1089 \u1090 \u1091 \u1087 \u1085 \u1099 ";\
                if (stateEl) \{\
                    stateEl.textContent = "\uc0\u1055 \u1088 \u1086 \u1074 \u1077 \u1088 \u1100 \u1090 \u1077  \u1087 \u1086 \u1076 \u1082 \u1083 \u1102 \u1095 \u1077 \u1085 \u1080 \u1077  \u1087 \u1086 \u1079 \u1078 \u1077 ";\
                    stateEl.classList.add("is-error");\
                \}\
            \}\
        \}\
    \}\
\
/* =====================================================\
\
       NEWS\
\
       ===================================================== */\
\
\
\
    const NEWS_API_URL =\
\
        "https://urban-estate-news-test.vercel.app/api/news";\
